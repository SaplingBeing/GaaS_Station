@{ViewData["Title"] = "GaaS";}
<link rel="stylesheet" href="~/css/gaasStyleSheet.css" asp-append-version="true">
<div id="map"></div>
<div class="offcanvas offcanvas-start p-3 position-absolute" data-bs-scroll="true" data-bs-backdrop="false" id="offcanvasGaas">
    <button class="offcanvasBtn position-absolute" data-bs-toggle="offcanvas" data-bs-target="#offcanvasGaas">GaaS</button>
    <div class="offcanvas-header">
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form method="POST" class="mb-3">
            <div class="row p-0">
                <div class="col-12 p-1 position-relative">
                    <span class="position-absolute mt-1 ms-3 z-3"><img src="/images/geo-alt.svg" alt="Location Icon"></span>
                    <input type="text" class="form-control w-100 ps-5" id="locationTb" placeholder="Enter location...">
                </div>
            </div>
            <div class="row p-0">
                <div class="col-sm-6 p-1 position-relative">
                    <span class="position-absolute mt-1 ms-3 z-3"><img src="/images/shop.svg" alt="Station Icon"></span>
                    <select class="form-select p-2 ps-5">
                        <option selected>Station</option>
                        <option value="BP">BP</option>
                        <option value="Mobil">Mobil</option>
                        <option value="Z-Energy">Z Energy</option>
                        <option value="Gull">Gull</option>
                    </select>
                </div>
                <div class="col-sm-6 p-1 position-relative">
                    <span class="position-absolute mt-1 ms-3 z-3"><img src="/images/fuel-pump.svg" alt="Fuel Type Icon"></span>
                    <select class="form-select p-2 ps-5">
                        <option selected class="dropdown-item">Fuel Type</option>
                        <option value="91">91</option>
                        <option value="95">95</option>
                        <option value="98">98</option>
                        <option value="E10">E10</option>
                        <option value="Disel">Diesel</option>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-12 p-1">
                    <button type="submit" class="btn d-inline-flex align-items-center justify-content-center w-100 p-2 primaryBtn"><img src="/images/search.svg" alt="Search Icon">Search</button>
                </div>
            </div>
        </form>
        <hr>
        <div class="p-3 container-fluid glassBg">
            <div class="row">
                <div class="col-2">
                    <img src="~/images/zenergyLogo.png" alt="Z Energy Logo"/>
                </div>
                <div class="col-2">
                    <h3>91</h3>
                    <h3>95</h3>
                    <h3>Disel</h3>
                </div>
                <div class="col-8 position-relative">
                    <h3 class="fw-bold">Z Energy Hunter's Corner</h3>
                    <p>72-76 East Tamaki Road, Papatoetoe, Auckland 2025</p>
                    <button type="button" class="btn position-absolute top-0 end-0 me-3 glassBg"><img src="/images/heart.svg" alt="Favourite Icon"></button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.js"></script>
<script>
    const aucklandBounds = [
        [174.450, -37.150], 
        [175.250, -36.400]
    ]
    const map = new maplibregl.Map({
        container: 'map',
        style: 'https://tiles.openfreemap.org/styles/liberty',
        center: [174.76, -36.85], // lng, lat — Auckland
        zoom: 11,
        attributionControl: false,
        dragRotate: false,
        pitchWithRotate: false,  
        touchPitch: false,       
        dragPan: { inertia: false }
    });
    const marker = new maplibregl.Marker()
  .setLngLat([174.76, -36.85])
  .addTo(map);
    map.addControl(new maplibregl.NavigationControl());
    map.touchZoomRotate.disableRotation();
    map.setMaxBounds(aucklandBounds);
</script>