@{
	ViewData["Title"] = "About Us";
}
<link rel="stylesheet" href="~/css/homeStyleSheet.css" asp-append-version="true">

@*About Us*@
<div class="row">
	<div class="col-12 text-center mb-3">
		<h1><b>About Us</b></h1>
	</div>
	<div class="col-12">
		<h3 class="px-5 m-2 " style="text-align: center; font-family:'Inter', sans-serif; font-weight:100; letter-spacing: 0.1em;">
			At GaaS (Gas as a Service), we take the guesswork out of refueling. Built to make local fuel pricing transparent and accessible, GaaS brings live,
			location-driven market data straight to your screen. Whether you are commuting to work, running weekend errands, or navigating a road trip,
			our platform ensures you never pay more than you have to at the pump.
		</h3>
	</div>
</div>

@* Our Vision *@
<div class="row p-3 m-3">
	<div class="col-6 text-center">
		<h1><b>Our Vision</b></h1>
		<p style="font-family:'Inter', sans-serif; font-weight:100; letter-spacing: 0.1em;">To empower drivers with instant price transparency, saving everyday motorists time and money through simple, data-driven technology.</p>
	</div>
	<div class="col-6"> 
		<img src="~/images/GasStation.jpg" class="img-fluid w-75 rounded" alt="Our Mission">
	</div>
</div>

@* Our Mission *@
<div class="row p-3 m-3">
	<div class="col-6">
		<img src="~/images/SaveMoney.jpg" class="img-fluid w-75 rounded" alt="Our Mission">
	</div>
	<div class="col-6 text-center">
		<h1><b>Our Mission</b></h1>
		<p style="font-family:'Inter', sans-serif; font-weight:100; letter-spacing: 0.1em;">To build the most trusted, seamless smart mobility companion for drivers, driving down fuel expenses and making everyday travel effort-free.</p>
	</div>
</div>

@* what we do *@
<div class="row">
	<div class="col-4 text-center">
		<img src="~/images/time.png" class="img-fluid w-50 p-3 m-2" alt="Time">
		<h2><b>Real-Time Pricing</b></h2>
		<p class="p-3">Access up-to-the-minute station pricing aggregated across surrounding networks. You always see live pump rates before you drive out of your way.</p>
	</div>
	<div class="col-4 text-center">
		<img src="~/images/filter.png" class="img-fluid w-50 p-3 m-2" alt="Filter">
		<h2><b>Fuel Filtering</b></h2>
		<p class="p-3">Instantly narrow down results to match your vehicle's specific requirement, whether you need Regular 91, Premium 95, Performance 98, or Diesel. </p>
	</div>
	<div class="col-4 text-center">
		<img src="~/images/radar-chart.png" class="img-fluid w-50 p-3 m-2" alt="Radius">
		<h2><b>Radius Search</b></h2>
		<p class="p-3">Tailor your search area using custom kilometer radii or GPS location to pinpoint the absolute cheapest fuel nearby or along your exact route. </p>
	</div>
</div>

@* Meet the Team *@
<div class="row">
	<div class="col-12 text-center mb-3">
		<h1><span class="fst-italic">Meet</span> the <span class="highlight">Team</span></h1>
		<h2>We’re a team of developers and data enthusiasts on a mission to make fuel prices transparent and accessible for everyone in Auckland.</h2>
	</div>
</div>
<div class="d-flex justify-content-center mb-5">
	<div class="row">
		<div class="col-sm-4 position-relative mb-3">
			<img src="/images/Dara.png" alt="Dara" class="mx-auto teamImg">
			<h1 class="position-absolute top-0 start-50 translate-middle-x mt-5 name">Dara</h1>
		</div>
		<div class="col-sm-4 position-relative mb-3">
			<img src="/images/Dustin.png" alt="Dustin" class="mx-auto teamImg">
			<h1 class="position-absolute top-0 start-50 translate-middle-x mt-5 name">Dustin</h1>
		</div>
		<div class="col-sm-4 position-relative">
			<img src="/images/Justin.png" alt="Justin" class="mx-auto teamImg">
			<h1 class="position-absolute top-0 start-50 translate-middle-x mt-5 name">Justin</h1>
		</div>
	</div>
</div>

