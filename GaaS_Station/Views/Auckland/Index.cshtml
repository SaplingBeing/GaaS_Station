@{
	ViewData["Title"] = "Auckland POI";
}
<link rel="stylesheet" href="~/css/homeStyleSheet.css" asp-append-version="true">

@*Auckland POI*@
<div class="row">
	<div class="col-12 text-center mb-3">
		<h1><b>Explore Auckland</b></h1>
	</div>
</div>

<div id="photoCarousel" class="carousel slide">
	<div class="carousel-inner d-flex align-items-center">
	</div>

	<button class="carousel-control-prev" type="button"
			data-bs-target="#photoCarousel" data-bs-slide="prev">
		<span class="carousel-control-prev-icon"></span>
	</button>

	<button class="carousel-control-next" type="button"
			data-bs-target="#photoCarousel" data-bs-slide="next">
		<span class="carousel-control-next-icon"></span>
	</button>
</div>

<style>
	/* Side photos: smaller, blurred, lower opacity */
	.carousel-side-img {
		height: 200px;
		object-fit: cover;
		filter: blur(4px);
		opacity: 0.5;
		transform: scale(0.85);
		transition: all 0.4s ease-in-out;
		border-radius: 8px 8px 0 0;
	}

	/* Middle photo: larger, crisp focus */
	.carousel-center-img {
		height: 280px;
		object-fit: cover;
		filter: blur(0);
		opacity: 1;
		transform: scale(1);
		transition: all 0.4s ease-in-out;
		box-shadow: 0 4px 15px rgba(0,0,0,0.3);
		z-index: 2;
		border-radius: 8px 8px 0 0;
	}

	/* Card Details Container */
	.poi-details {
		background: #ffffff;
		border-radius: 0 0 8px 8px;
		box-shadow: 0 4px 10px rgba(0,0,0,0.1);
		transition: all 0.4s ease-in-out;
	}

	.carousel-side-details {
		opacity: 0.5;
		filter: blur(2px);
		transform: scale(0.85);
	}

	.carousel-center-details {
		opacity: 1;
		transform: scale(1);
	}
</style>

<script>
	const carousel = document.querySelector('#photoCarousel');
	const inner = carousel.querySelector('.carousel-inner');

	// Store photo information as structured objects
	const pois = [
		{
			src: 'waitakere-ranges.png',
			title: 'Waitakere Ranges',
			location: 'West Auckland',
			description: 'Lush native rainforest and dramatic black-sand beaches.'
		},
		{
			src: 'winter-garden.jpeg',
			title: 'Domain Wintergardens',
			location: 'Parnell',
			description: 'Historic Victorian-style glasshouses with exotic plants.'
		},
		{
			src: 'sky-tower.jpg',
			title: 'Sky Tower',
			location: 'Auckland CBD',
			description: 'Iconic 328-metre tower with 360° views across the city.'
		}
	];

	let index = 0;

	function renderCarousel() {
		inner.innerHTML = '';

		for (let i = 0; i < 3; i++) {
			const poiIndex = (index + i) % pois.length;
			const poi = pois[poiIndex];
			
			const isCenter = (i === 1);
			const imgClass = isCenter ? 'carousel-center-img' : 'carousel-side-img';
			const detailClass = isCenter ? 'carousel-center-details' : 'carousel-side-details';

			inner.innerHTML += `
					<div class="col-4 d-flex flex-column align-items-center">
						<img src="/images/${poi.src}"
							 class="w-100 ${imgClass}"
							 alt="${poi.title}">
						<div class="poi-details w-100 p-3 text-center ${detailClass}">
							<h5 class="fw-bold mb-1">${poi.title}</h5>
							<p class="text-muted small mb-1"> ${poi.location}</p>
							<p class="mb-0 text-secondary" style="font-size: 0.85rem;">${poi.description}</p>
						</div>
					</div>
				`;
		}
	}

	inner.classList.add('row', 'g-2');

	carousel.querySelector('.carousel-control-next')
		.addEventListener('click', () => {
			index = (index + 1) % pois.length;
			renderCarousel();
		});

	carousel.querySelector('.carousel-control-prev')
		.addEventListener('click', () => {
			index = (index - 1 + pois.length) % pois.length;
			renderCarousel();
		});

	renderCarousel();
</script>