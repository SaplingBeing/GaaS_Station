@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Register confirmation";
    ViewData["Hide"] = true;
}
<img src="~/images/bg2.png" class="bgImage">
<div class="row vh-100">
    <div class="col-sm-5 d-grid align-items-center p-5 glassBg regLogContainer">
        <div class="row">
            <h1>Register Confirmation</h1>
            @{
                if (@Model.DisplayConfirmAccountLink)
                {
                    <p> This app does not currently have a real email sender registered.</p>
                    <a id="confirm-link" class="w-100 btn p-2 primaryBtn" href="@Model.EmailConfirmationUrl"><h2 class="m-0">Confirm your account</h2></a>
                }
                else
                {
                    <p>
                        Please check your email to confirm your account.
                    </p>
                }
            }
        </div>
    </div>
</div>


