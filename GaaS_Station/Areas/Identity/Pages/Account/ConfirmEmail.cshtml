@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
    ViewData["Hide"] = true;
}
<img src="~/images/bg2.png" class="bgImage">
<div class="row vh-100">
    <div class="col-md-5 d-flex flex-column justify-content-center p-5 glassBg regLogContainer">
        <div class="row">
            <h1>Confirm email</h1>
            <partial name="_StatusMessage" model="Model.StatusMessage" />
            <a class="w-100 mb-3 p-2 btn primaryBtn fontSizeLg" asp-page="./Login">Return to login</a>
        </div>
    </div>
</div>