@{
    ViewData["Title"] = "GaaS";
    var results = ViewData["Results"] as List<StationResult>;
    var searchStation = ViewData["SearchStation"] as string;
    var searchFuelType = ViewData["SearchFuelType"] as string;
    var favourites = ViewData["Favourites"] as List<int>;
    var hasCurrentLocation = ViewData["Latitude"] != null && ViewData["Longitude"] != null;
    var centerLng = hasCurrentLocation ? ViewData["Longitude"] : results != null && results.Count > 0 ? results[0].Longitude : 174.76m;
    var centerLat = hasCurrentLocation ? ViewData["Latitude"] : results != null && results.Count > 0 ? results[0].Latitude : -36.85m;
}
<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.css">
<link rel="stylesheet" href="~/css/gaasStyleSheet.css" asp-append-version="true">
<script src="~/js/Weather.js"></script>
<div id="map"></div>
<div class="row">
    <div class="col-12">
        <div class="d-inline-flex flex-wrap flex-column p-3 glassBg" id="weatherContainer">
            <p class="m-0">Loading weather...</p>
        </div>
    </div>
</div>
<div class="offcanvas offcanvas-start p-3 position-absolute" data-bs-scroll="true" data-bs-backdrop="false" id="offcanvasGaas">
    <button class="offcanvasBtn position-absolute" data-bs-toggle="offcanvas" data-bs-target="#offcanvasGaas">GaaS</button>
    <div class="offcanvas-header">
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form method="POST" class="mb-3" asp-controller="Home" asp-action="Search">
            <div class="row p-0">
                <div class="col-12 p-1 position-relative">
                    <span class="position-absolute mt-1 ms-3 z-3"><img src="/images/geo-alt.svg" alt="Location Icon"></span>
                    <input type="text" class="form-control w-100 ps-5" id="locationTb" name="locationTb" value="@ViewData["SearchLocation"]" placeholder="Enter location...">
                </div>
            </div>
            <div class="row p-0">
                <div class="col-sm-6 p-1 position-relative">
                    <span class="position-absolute mt-1 ms-3 z-3"><img src="/images/shop.svg" alt="Station Icon"></span>
                    <select class="form-select p-2 ps-5" name="station">
                        <option selected>Station</option>
                        <option value="BP" selected="@(searchStation == "BP")">BP</option>
                        <option value="Z Energy" selected="@(searchStation == "Z Energy")">Z Energy</option>
                        <option value="Caltex" selected="@(searchStation == "Caltex")">Caltex</option>
                    </select>
                </div>
                <div class="col-sm-6 p-1 position-relative">
                    <span class="position-absolute mt-1 ms-3 z-3"><img src="/images/fuel-pump.svg" alt="Fuel Type Icon"></span>
                    <select class="form-select p-2 ps-5" name="fuelType">
                        <option selected>Fuel Type</option>
                        <option value="91" selected="@(searchFuelType == "91")">91</option>
                        <option value="95" selected="@(searchFuelType == "95")">95</option>
                        <option value="98" selected="@(searchFuelType == "98")">98</option>
                        <option value="Diesel" selected="@(searchFuelType == "Diesel")">Diesel</option>
                    </select>
                </div>
            </div>
            <div class="row">
                <div class="col-12 p-1">
                    <button type="submit" class="btn d-inline-flex align-items-center justify-content-center w-100 p-2 primaryBtn"><img src="/images/search.svg" alt="Search Icon">Search</button>
                </div>
            </div>
        </form>
        <hr>
        @if (ViewData["Error"] != null)
        {
            <p>@ViewData["Error"]</p>
        }
        else if (results != null && results.Count == 0)
        {
            <p>No result found. Please try a different search</p>
        }
        else if (results != null)
        {
            @foreach (var result in results)
            {
                <div class="p-3 mb-3 container-fluid glassBg resultContainer"
                     data-lat="@result.Latitude.ToString()"
                     data-lng="@result.Longitude.ToString()"
                     style="cursor: pointer;">
                    <div class="row">
                        <div class="col-2">
                            <img src="@result.Icon" alt="@result.Brand Logo" class="w-100 ratio-1x1">
                        </div>
                        <div class="col-3">
                            @foreach (var price in result.Prices)
                            {
                                <p class="mb-1"><span class="fw-bold">@price.FuelType?.Split(" (")[0]</span> $@price.PriceValue.ToString("0.000")</p>
                            }
                        </div>
                        <div class="col-6 position-relative">
                            <h3 class="fw-bold">@result.Brand - @result.Branch</h3>
                            <p>@result.AddressString</p>
                        </div>
                        <div class="col-1">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form asp-controller="Gaas" asp-action="Favourite" method="post">
                                        <input type="hidden" name="stationId" value="@result.StationID">
                                        <input type="hidden" name="locationTb" value="@ViewData["SearchLocation"]">
                                        <input type="hidden" name="station" value="@ViewData["SearchStation"]">
                                        <input type="hidden" name="fuelType" value="@ViewData["SearchFuelType"]">
                                        <input type="hidden" name="latitude" value="@ViewData["Latitude"]">
                                        <input type="hidden" name="longitude" value="@ViewData["Longitude"]">
                                        <button type="submit" class="btn position-absolute top-0 end-0 m-3 glassBg"><img src="@(favourites != null && favourites.Contains(result.StationID) ? "/images/heart-fill.svg" : "/images/heart.svg")" alt="Favourite Icon"></button>
                                    </form>
                                }
                                else
                                {
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn position-absolute top-0 end-0 m-3 glassBg"><img src="/images/heart.svg" alt="Favourite Icon"></a>
                                }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
@if (results != null)
{
    <div class="d-none">
        @foreach (var result in results)
        {
            <div class="stationMarker d-flex align-items-center bg-white rounded-pill shadow p-1 pe-3" data-lng="@result.Longitude" data-lat="@result.Latitude">
                <img src="@result.Icon" alt="@result.Brand Logo" class="me-2" style="width: 30px; height: 30px;">
                <div>
                    <h3 class="m-0 fw-bold">@result.Brand - @result.Branch</h3>
                    <p class="m-0" style="max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@result.AddressString</p>
                </div>
            </div>
        }
    </div>
}
<script src="https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.js"></script>
<script>
    // Map boundaries (Restricted to Auckland)
    const aucklandBounds = [
        [174.450, -37.210],
        [175.250, -36.400]
    ]
    const map = new maplibregl.Map({
        container: "map",
        style: "https://tiles.openfreemap.org/styles/liberty",
        center: [@centerLng, @centerLat],
        zoom: 11,
        attributionControl: false,
        dragRotate: false,
        pitchWithRotate: false,
        touchPitch: false,
        dragPan: { inertia: false }
    });
    const showSidebar = @(results != null || ViewData["Error"] != null ? "true" : "false");
    const hasCurrentLocation = @(hasCurrentLocation ? "true" : "false");
    const searched = @((bool)(ViewData["Searched"] ?? false) ? "true" : "false");
    if (showSidebar) {
        document.addEventListener("DOMContentLoaded", function () {
            bootstrap.Offcanvas.getOrCreateInstance("#offcanvasGaas").show();
        });
    }
    if (hasCurrentLocation) {
        const marker = new maplibregl.Marker({ color: "red" })
            .setLngLat([@centerLng, @centerLat])
            .addTo(map);
    }
    else if (!searched) {
        navigator.geolocation.getCurrentPosition(function (position) {
            window.location.href = "/Gaas?latitude=" + position.coords.latitude + "&longitude=" + position.coords.longitude;
        });
    }
    document.querySelectorAll(".stationMarker").forEach(function (stationMarker) {
        new maplibregl.Marker({ element: stationMarker })
            .setLngLat([stationMarker.dataset.lng, stationMarker.dataset.lat])
            .addTo(map);
    });
    map.addControl(new maplibregl.NavigationControl());
    map.touchZoomRotate.disableRotation();
    map.setMaxBounds(aucklandBounds);
    // Zoom animation to zoom into a specific station when result is clicked 
    document.querySelectorAll(".resultContainer").forEach(function (resultItem) {
        resultItem.addEventListener("click", function () {
            const lat = parseFloat(resultItem.dataset.lat);
            const lng = parseFloat(resultItem.dataset.lng);
            map.flyTo({
                center: [lng, lat],
                zoom: 15,
                essential: true
            });
        });
    });
</script>