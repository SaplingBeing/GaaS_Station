@model IEnumerable<GaaS_Station.ViewModel.AdminVM>

@{
    ViewData["Title"] = "Manage Users";
}

<h1 class="mb-3">Manage Users</h1>
<div class="row mb-5">
    <form id="searchForm" action="/Admin/Index" method="get">
        <div>
            <input type="text" id="searchString" name="searchString" style="width:180px" autocomplete="off" onkeyup="XAjaxRequest(this.value)" />
            <button type="submit" class="btn primaryBtn">Search</button>
            <a asp-action="Index" class="btn secondaryBtn">Show All</a>
        </div>
        <div id="autoSuggestContainer" style="position:absolute;display:none;">
        </div>
    </form>
</div>

<div class="row">
    <div class="col-md-12">
        <table class="table glassBg">
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Username / Email</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Roles</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="glassBg">
                        <td>@user.Id</td>
                        <td>@user.Email</td>
                        <td>@user.FirstName</td>
                        <td>@user.LastName</td>
                        <td>
                            @foreach (var role in user.UserRoles)
                            {
                                <span class="badge text-bg-primary">@role</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn secondaryBtn me-1">
                                Edit
                            </a>
                            <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                <button type="submit" class="btn primaryBtn">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<script type="text/javascript">
    function XAjaxRequest(searchString) {
        if (searchString.length < 3) {
            document.getElementById("autoSuggestContainer").innerHTML = "";
            return;
        }
        xmlhttp = new XMLHttpRequest();
        var url = "/Admin/IndexAJAX?searchString=" + searchString;
        xmlhttp.open("GET", url, false);
        xmlhttp.send();
        document.getElementById("autoSuggestContainer").style.display = "block";
        document.getElementById("autoSuggestContainer").innerHTML = "";
        var messageObject = JSON.parse(xmlhttp.responseText);
        var autoSuggestions = "";
        for (var i = 0; i < messageObject.length; i++) {
            var displayName = messageObject[i].Name || (messageObject[i].FirstName + " " + messageObject[i].LastName);
            autoSuggestions +=
                "<input type=\"button\" value=\"" + displayName + "\" "
                + "onclick=\"document.getElementById('searchString').value = this.value; document.getElementById('searchForm').submit();\" "
                + "style =\"width: 280px\" />";
            autoSuggestions += "<br />";
        }
        document.getElementById("autoSuggestContainer").innerHTML = autoSuggestions;
    }
</script> 