@{
    ViewData["Title"] = "Home Page";
}
@* Search *@
<form class="d-flex justify-content-center mb-3" method="POST">
    <div class="d-inline-block p-5 glassBg">
        <div class="row p-0">
            <div class="col-12 p-0">
                <h1 class="text-center mb-4">Find the <span class="highlight">Cheapest Fuel</span> in <span class="fst-italic">Auckland</span></h1>
            </div>
        </div>
        <div class="row p-0">
            <div class="col-12 p-1">
                <input type="text" class="form-control p-2" id="locationTb" placeholder="Enter location...">
            </div>
        </div>
        <div class="row p-0">
            <div class="col-sm-5 p-1">
                <select class="form-select p-2">
                    <option selected>Station</option>
                    <option>BP</option>
                    <option>Mobil</option>
                    <option>Z Energy</option>
                    <option>Gull</option>
                </select>
            </div>
            <div class="col-sm-5 p-1">
                <select class="form-select p-2">
                    <option selected>Fuel Type</option>
                    <option>91</option>
                    <option>95</option>
                    <option>98</option>
                    <option>E10</option>
                    <option>Diesel</option>
                </select>
            </div>
            <div class="col-sm-2 p-1">
                <button type="submit" class="btn d-inline-flex align-items-center justify-content-center w-100 p-2 primaryBtn"><img src="/images/search.svg">Search</button>
            </div>
        </div>
    </div>
</form>
@* Auckland POI *@
<div class="glassBg p-4">
    <div class="row">
        <div class="col-sm-4">
            <h1><span class="fst-italic">Travel</span> with <span class="highlight">Purpose</span></h1>
            <button class="btn w-50 p-2 primaryBtn">Explore</button>
        </div>
        <div class=col-sm-8>
            <img src="/images/Waitakere Ranges.png" alt="Waitakere Ranges"></img>
        </div>
    </div>    
</div>
@* Meet the Team *@
<div class="d-flex justify-content-center">
    <div class="row">
        <div class="col-12 text-center">
            <h1><span class="fst-italic">Meet</span> our <span class="highlight">Team</span></h1>
            <h2>We’re a team of developers and data enthusiasts on a mission to make fuel prices transparent and accessible for everyone in Auckland.</h2>
        </div>
    </div>
</div>
<div class="d-flex justify-content-center">
    <div class="row">
    <div class="col-md-4 imgContainer">
        <img src="/images/Dara.png" alt="Dara" class="teamImg">
        <div class="imgText">
            <h3>Dara</h3>
        </div>
    </div>
    <div class="col-md-4">
        <img src="/images/Dustin.png" alt="Dustin" class="teamImg">
    </div>
    <div class="col-md-4">
        <img src="/images/Justin.png" alt="Justin" class="teamImg">
    </div>
</div>
</div>

