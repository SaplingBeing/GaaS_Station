@{
    ViewData["Title"] = "Home Page";
}
@* Search *@
<form class="d-flex justify-content-center mb-5" method="POST">
    <div class="d-inline-block p-5 glassBg" id="searchContainer">
        <div class="row p-0">
            <div class="col-12 p-0">
                <h1 class="text-center mb-4">Find the <span class="highlight">Cheapest Fuel</span> in <span class="fst-italic">Auckland</span></h1>
            </div>
        </div>
        <div class="row p-0">
            <div class="col-12 p-1 position-relative">
                <span class="position-absolute mt-1 ms-3 z-3"><img src="/images/geo-alt.svg" alt="Location Icon"></span>
                <input type="text" class="form-control p-2 ps-5" id="locationTb" placeholder="Enter location...">
            </div>
        </div>
        <div class="row p-0">
            <div class="col-sm-5 p-1 position-relative">
                <span class="position-absolute mt-1 ms-3 z-3"><img src="/images/shop.svg" alt="Station Icon"></span>
                <select class="form-select p-2 ps-5">
                    <option selected>Station</option>
                    <option value="BP">BP</option>
                    <option value="Mobil">Mobil</option>
                    <option value="Z-Energy">Z Energy</option>
                    <option value="Gull">Gull</option>
                </select>
            </div>
            <div class="col-sm-5 p-1 position-relative">
                <span class="position-absolute mt-1 ms-3 z-3"><img src="/images/fuel-pump.svg" alt="Fuel Type Icon"></span>
                <select class="form-select p-2 ps-5">
                    <option selected class="dropdown-item">Fuel Type</option>
                    <option value="91">91</option>
                    <option value="95">95</option>
                    <option value="98">98</option>
                    <option value="E10">E10</option>
                    <option value="Disel">Diesel</option>
                </select>
            </div>
            <div class="col-sm-2 p-1">
                <button type="submit" class="btn d-inline-flex align-items-center justify-content-center w-100 p-2 primaryBtn"><img src="/images/search.svg" alt="Search Icon">Search</button>
            </div>
        </div>
    </div>
</form>
<br />
@* Auckland POI *@
<div class="glassBg d-inline-block overflow-hidden p-0 m-5" id="poiContainer">
    <div class="row">
        <div class="col-md-7 p-0 d-flex position-relative justify-content-end">
            <img src="/images/sky-tower.jpg" alt="Sky Tower" class="featuredImg z-3" id="img1">
            <img src="/images/winter-garden.jpeg" alt="Winter Garden" class="featuredImg z-2" id="img2">
            <img src="/images/waitakere-ranges.png" alt="Waitakere Ranges" class="featuredImg z-1" id="img3">
        </div>
        <div class="col-md-5 order-md-first p-5">
            <h1><span class="fst-italic">Travel</span> with <span class="highlight">Purpose</span></h1>
            <button class="btn p-2 secondaryBtn">Explore</button>
        </div>
    </div>    
</div>
@* Meet the Team *@
<div class="d-flex position-relative justify-content-center">
    <div class="row">
        <div class="col-12 text-center">
            <h1><span class="fst-italic">Meet</span> our <span class="highlight">Team</span></h1>
            <h2>We’re a team of developers and data enthusiasts on a mission to make fuel prices transparent and accessible for everyone in Auckland.</h2>
        </div>
    </div>
</div>
<div class="d-flex justify-content-center">
    <div class="row">
    <div class="col-md-4 imgContainer">
        <img src="/images/Dara.png" alt="Dara" class="teamImg">
        <div class="imgText">
            <h3>Dara</h3>
        </div>
    </div>
    <div class="col-md-4">
        <img src="/images/Dustin.png" alt="Dustin" class="teamImg">
    </div>
    <div class="col-md-4">
        <img src="/images/Justin.png" alt="Justin" class="teamImg">
    </div>
</div>
</div>

