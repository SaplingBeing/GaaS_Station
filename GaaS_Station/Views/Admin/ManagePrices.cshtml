@model GaaS_Station.ViewModel.StationPriceManagementVM
@{
    ViewData["Title"] = "Manage Station Prices";
}
<img src="~/images/bg5.png" alt="Background Image" id="backgroundImgFull">
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-center align-items-center">
                <div class="w-75 p-5 glassBg">
                    <h1 class="mb-0">Manage Prices</h1>
                    <h2>@Model.StationName</h2>
                    <hr>
                    <table class="table table-bordered align-middle mt-3">
                        <thead>
                            <tr>
                                <th>Fuel Type</th>
                                <th colspan="2">Current Price (NZ$)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.FuelTypes != null && Model.FuelTypes.Any())
                            {
                                @foreach (var fuel in Model.FuelTypes)
                                {
                                    var existingPrice = Model.Prices.FirstOrDefault(p => p.FuelTypeId == fuel.FuelId);
                                    <tr>
                                        <td class="align-middle glassBg">@fuel.FuelTypeName</td>
                                        <td class="align-middle glassBg" colspan="2">
                                            <form asp-action="SaveStationPrice" method="post" class="d-flex align-items-center gap-2">
                                                <input type="hidden" name="StationId" value="@Model.StationId">
                                                <input type="hidden" name="FuelTypeId" value="@fuel.FuelId">
                                                <input type="hidden" name="PriceId" value="@(existingPrice?.PriceId ?? 0)">
                                                <input type="number" step="0.001" name="PriceValue" class="form-control" value="@(existingPrice != null ? existingPrice.PriceValue.ToString("0.000") : "")" placeholder="e.g. 3.123" required>
                                                <button type="submit" class="btn primaryBtn text-nowrap">
                                                    @(existingPrice != null ? "Update Price" : "Add Price")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted">No fuel types found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                        <a asp-action="EditStation" asp-route-id="@Model.StationId" class="btn secondaryBtn">Back to Station Details</a>
                </div>
            </div>
        </div>
    </div>
</div>