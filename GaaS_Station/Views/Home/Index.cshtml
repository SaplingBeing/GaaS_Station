@{
    ViewData["Title"] = "Home";
    var searchStation = ViewData["SearchStation"] as string;
    var searchFuelType = ViewData["SearchFuelType"] as string;
    var favourites = ViewData["Favourites"] as List<StationResult>;
}
<link rel="stylesheet" href="~/css/homeStyleSheet.css" asp-append-version="true">
@*Background image*@
<img src="~/images/bg.jpg" alt="Background Image" id="backgroundImg" />
@*GaaS search bar*@
<form class="d-flex justify-content-center" id="searchContainer" asp-controller="Home" asp-action="Search" method="POST">
    <div class="d-inline-block p-5 m-3 glassBg">
        <div class="row p-0">
            <div class="col-12 p-0">
                <h1 class="text-center mb-3">Find Auckland's<span class="fst-italic highlight"> Cheapest Gas</span></h1>
            </div>
        </div>
        <div class="row p-0">
            <div class="col-12 p-1 position-relative">
                <span class="position-absolute mt-1 ms-3 z-3"><img src="/images/geo-alt.svg" alt="Location Icon"></span>
                <input type="text" class="form-control p-2 ps-5" id="locationTb" name="locationTb" placeholder="Enter location...">
            </div>
        </div>
        <div class="row p-0">
            <div class="col-sm-5 p-1 position-relative">
                <span class="position-absolute mt-1 ms-3 z-3"><img src="/images/shop.svg" alt="Station Icon"></span>
                <select class="form-select p-2 ps-5" name="station">
                    <option selected>Station</option>
                    <option value="BP" selected="@(searchStation == "BP")">BP</option>
                    <option value="Z Energy" selected="@(searchStation == "Z Energy")">Z Energy</option>
                    <option value="Caltex" selected="@(searchStation == "Caltex")">Caltex</option>
                </select>
            </div>
            <div class="col-sm-5 p-1 position-relative">
                <span class="position-absolute mt-1 ms-3 z-3"><img src="/images/fuel-pump.svg" alt="Fuel Type Icon"></span>
                <select class="form-select p-2 ps-5" name="fuelType">
                    <option selected>Fuel Type</option>
                    <option value="91" selected="@(searchFuelType == "91")">91</option>
                    <option value="95" selected="@(searchFuelType == "95")">95</option>
                    <option value="98" selected="@(searchFuelType == "98")">98</option>
                    <option value="Diesel" selected="@(searchFuelType == "Diesel")">Diesel</option>
                </select>
            </div>
            <div class="col-sm-2 p-1">
                <button type="submit" class="btn d-inline-flex align-items-center justify-content-center w-100 p-2 primaryBtn"><img src="/images/search.svg" alt="Search Icon">Search</button>
            </div>
        </div>
    </div>
</form>
<br>
@* Favourites *@
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="container p-5 mb-5 glassBg">
        <div class="row">
            <div class="col-12 text-center">
                <h1><span class="fst-italic">Your</span> Favourite <span class="highlight">Stations</span></h1>
            </div>
        </div>
        <div class="row row-cols-md-2 g-5">
            @if (favourites == null || favourites.Count == 0)
            {
                <h2 class="text-center w-100">No favourites yet.</h2>
            }
            else
            {
                @foreach (var result in favourites)
                {
                    <div class="col-12">
                        <div class="p-3 container-fluid glassBg">
                            <div class="row">
                                <div class="col-2">
                                    <img src="@result.Icon" alt="@result.Brand Logo" class="w-100 ratio-1x1">
                                </div>
                                <div class="col-3">
                                    @foreach (var price in result.Prices)
                                    {
                                        <p class="mb-1"><span class="fw-bold">@price.FuelType?.Split(" (")[0]</span> $@price.PriceValue.ToString("0.000")</p>
                                    }
                                </div>
                                <div class="col-6 position-relative">
                                    <h3 class="fw-bold">@result.Brand - @result.Branch</h3>
                                    <p>@result.AddressString</p>
                                </div>
                                <div class="col-1">
                                    <form asp-controller="Gaas" asp-action="Favourite" method="post">
                                        <input type="hidden" name="stationId" value="@result.StationID">
                                        <input type="hidden" name="returnTo" value="Home">
                                        <button type="submit" class="btn position-absolute top-0 end-0 m-3 glassBg"><img src="/images/heart-fill.svg" alt="Favourite Icon"></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}
@* Auckland POI *@
<div class="d-inline-block overflow-hidden p-0 m-5 glassBg" id="poiContainer">
    <div class="row">
        <div class="col-sm-7 d-flex position-relative justify-content-end p-0">
            <img src="/images/sky-tower.jpg" alt="Sky Tower" class="featuredImg z-3" id="img1">
            <img src="/images/winter-garden.jpeg" alt="Winter Garden" class="featuredImg z-2" id="img2">
            <img src="/images/waitakere-ranges.png" alt="Waitakere Ranges" class="featuredImg z-1" id="img3">
        </div>
        <div class="col-sm-5 order-sm-first p-5">
            <h1><span class="fst-italic">Travel</span> with <span class="highlight">GaaS</span></h1>
            <a class="btn w-50 p-2 secondaryBtn" asp-area="" asp-controller="Gaas" asp-action="Index">Explore</a>
        </div>
    </div>
</div>
@* Meet the Team *@
<div class="row">
    <div class="col-12 text-center mb-3">
        <h1><span class="fst-italic">Meet</span> the <span class="highlight">Team</span></h1>
        <h2>We’re a team of developers and data enthusiasts on a mission to make fuel prices transparent for everyone in Auckland.</h2>
    </div>
</div>
<div class="d-flex justify-content-center mb-5">
    <div class="row">
        <div class="col-sm-4 position-relative mb-3">
            <img src="/images/Dara.png" alt="Dara" class="mx-auto teamImg">
            <h1 class="position-absolute top-0 start-50 translate-middle-x mt-5 name">Dara</h1>
        </div>
        <div class="col-sm-4 position-relative mb-3">
            <img src="/images/Dustin.png" alt="Dustin" class="mx-auto teamImg">
            <h1 class="position-absolute top-0 start-50 translate-middle-x mt-5 name">Dustin</h1>
        </div>
        <div class="col-sm-4 position-relative">
            <img src="/images/Justin.png" alt="Justin" class="mx-auto teamImg">
            <h1 class="position-absolute top-0 start-50 translate-middle-x mt-5 name">Justin</h1>
        </div>
    </div>
</div>
@* FAQ *@
<div class="container" id="faqContainer">
    <div class="row">
        <div class="col-12 mb-3">
            <h1>FAQ</h1>
            <h2>Answers to your questions can be found here:</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="accordion" id="questions">
                @* Question 1 *@
                <div class="accordion-item">
                    <h1 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#question1">
                            How does GaaS Work?
                        </button>
                    </h1>
                    <div class="collapse accordion-collapse" id="question1" data-bs-parent="questions">
                        <div class="accordion-body">
                            <p>By filtering for your vehicle's specific fuel type (91, 95, 98, or Diesel), GaaS aggregates pricing data across surrounding gas stations to compare rates instantly, guiding you to the cheapest option in your area.</p>
                        </div>
                    </div>
                </div>
                @* Question 2 *@
                <div class="accordion-item">
                    <h1 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#question2">
                            Who are we?
                        </button>
                    </h1>
                    <div class="collapse accordion-collapse" id="question2" data-bs-parent="questions">
                        <div class="accordion-body">
                            <p>GaaS (Gas as a Service) is a dedicated web platform designed to help drivers around auckland save money at the pump by making fuel prices transparent.</p>
                        </div>
                    </div>
                </div>
                @* Question 3 *@
                <div class="accordion-item">
                    <h1 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#question3">
                            What are the fuel types?
                        </button>
                    </h1>
                    <div class="collapse accordion-collapse" id="question3" data-bs-parent="questions">
                        <div class="accordion-body">
                            <ul>
                                <li><span class="fw-bold">91 Petrol:</span> Standard unleaded fuel for regular passenger cars</li>
                                <li><span class="fw-bold">95 Petrol:</span> Premium unleaded for high-performance, turbocharged, or imported engines</li>
                                <li><span class="fw-bold">98 Petrol:</span> High-octane fuel for sports cars and luxury vehicles requiring maximum power</li>
                                <li><span class="fw-bold">Diesel:</span> Fuel for commercial vehicles, trucks, and larger SUVs; paid via distance-based Road User Charges (RUC) rather than pump taxes</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="accordion" id="questions_p2">
                @* Question 4 *@
                <div class="accordion-item">
                    <h1 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#question4">
                            Why choose us?
                        </button>
                    </h1>
                    <div class="collapse accordion-collapse" id="question4" data-bs-parent="questions_4">
                        <div class="accordion-body">
                            <ul>
                                <li><span class="fw-bold">Smart Filtering:</span> Find exact pricing for your specific fuel type—whether 91, 95, 98, or Diesel.</li>
                                <li><span class="fw-bold">Location-Based Convenience:</span>Instant radius search shows you the cheapest gas along your route or near your current area.</li>
                            </ul>
                        </div>
                    </div>
                </div>
                @* Question 5 *@
                <div class="accordion-item mb-5">
                    <h1 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#question5">
                            Is it free?
                        </button>
                    </h1>
                    <div class="collapse accordion-collapse" id="question5" data-bs-parent="questions_pt2">
                        <div class="accordion-body">
                            <p>100% Free & Transparent: Easy, direct access to fuel data with no hidden costs.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>