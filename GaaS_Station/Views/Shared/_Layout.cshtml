<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GaaS Station</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GaaS_Station.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm mb-5 z-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="/images/GaaSLogo.png" alt="GaaS Station Logo" class="gaasLogo"></a>
                <button class="navbar-toggler glassBg" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <div class="glassBg">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Gaas" asp-action="Index">GaaS</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="#" asp-action="#">About</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="#" asp-action="#">Auckland POI</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="#" asp-action="#">Contact</a>
                            </li>
                        </ul>
                    </div>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    @* <div class="container-fluid"> *@
        <main role="main">
            @RenderBody()
        </main>
    @* </div> *@

    <footer class="footer">
        <div class="container-fluid">
            <div class="row gy-0">
                <div class="col-sm-6 lh-1 p-2">
                    <p class="m-0">&copy; 2026 GaaS Station | All Rights Reserved</p>
                </div>
                <div class="col-sm-6 lh-1 p-2 footerColR">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-reset text-decoration-none">Privacy Policy</a>
                    <span>|</span>
                    <a asp-area="" asp-controller="#" asp-action="#" class="text-reset text-decoration-none">Terms & Conditions</a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
