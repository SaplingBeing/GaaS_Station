@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
    ViewData["Hide"] = true;
}
<img src="~/images/bg2.png" class="bgImage">
<div class="row vh-100">
    <div class="col-sm-5 d-grid align-items-center p-5 glassBg regLogContainer">
        <form method="post">
            <a class="text-reset" asp-page="./Login"><h2>Return to Login</h2></a>
            <h1>Forgot your password?</h1>
            <p>Enter your email.</p>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn p-2 primaryBtn"><h2 class="m-0">Reset Password</h2></button>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
